---
type SectionKey = 'home' | 'about' | 'knowledge' | 'journal' | 'archive' | 'tags' | 'projects';

interface Props {
  title: string;
  description?: string;
  active?: SectionKey;
  exactTitle?: boolean;
}

const { title, description, active, exactTitle = false } = Astro.props;
const navItems: Array<{ key: SectionKey; label: string; href: string }> = [
  { key: 'home', label: '首页', href: '/' },
  { key: 'about', label: '个人主页', href: '/about/' },
  { key: 'knowledge', label: '知识库', href: '/getting-started/' },
  { key: 'journal', label: '博客', href: '/journal/' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#162b30" />
    {description && <meta name="description" content={description} />}
    <title>{exactTitle ? title : `${title} | Seren Spark Blog`}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="header-inner">
          <a class="brand" href="/" aria-label="返回 Seren Spark Blog 首页">
            <span class="brand-mark" aria-hidden="true">S</span>
            <span class="brand-copy">
              <strong>Seren Spark</strong>
              <small>知识档案</small>
            </span>
          </a>

          <nav class="site-nav" aria-label="主导航">
            {navItems.map((item) => (
              <a class:list={['nav-link', active === item.key && 'active']} href={item.href}>
                {item.label}
              </a>
            ))}
          </nav>

          <div class="header-status" title="网站正在持续建设中">
            <span class="status-dot" aria-hidden="true"></span>
            <span>持续记录中</span>
          </div>
        </div>
      </header>

      <slot name="banner" />
      <main class="site-main" id="main-content">
        <div class="page-frame">
          <slot />
        </div>
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <span>Seren Spark Blog</span>
          <span>把积累留在时间里</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --site-ink: #172b2d;
    --site-muted: #6b7b78;
    --site-background: #fff;
    --site-background-pattern: linear-gradient(90deg, rgba(60, 10, 30, .05) 3%, transparent 0), linear-gradient(1turn, rgba(60, 10, 30, .05) 3%, transparent 0);
    --site-surface: rgba(255, 255, 255, 0.7);
    --site-line: #d9dfd9;
    --site-accent: #bd703f;
    --site-teal: #227d70;
    --site-shadow: rgba(26, 48, 46, 0.08);
    color-scheme: light;
  }

  * { box-sizing: border-box; }

  html {
    background-color: var(--site-background);
    background-image: var(--site-background-pattern);
    background-size: 20px 20px;
  }

  body {
    min-width: 320px;
    margin: 0;
    background-color: var(--site-background);
    background-image: var(--site-background-pattern);
    background-size: 20px 20px;
    color: var(--site-ink);
    font-family: 'Avenir Next', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }

  a { color: inherit; }

  .site-shell { min-height: 100vh; }

  .site-header {
    position: sticky;
    z-index: 10;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--site-line) 82%, transparent);
    background: color-mix(in srgb, var(--site-background) 84%, transparent);
    backdrop-filter: blur(16px);
  }

  .header-inner,
  .page-frame,
  .footer-inner {
    width: min(100% - 2.5rem, 82rem);
    margin-inline: auto;
  }

  .header-inner {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.7rem;
    color: var(--site-ink);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--site-accent);
    color: var(--site-accent);
    font-family: 'Iowan Old Style', 'Palatino Linotype', serif;
    font-size: 1.25rem;
    font-style: italic;
  }

  .brand-copy { display: grid; gap: 0.15rem; }
  .brand-copy strong { font-family: 'Iowan Old Style', 'Palatino Linotype', serif; font-size: 1rem; font-weight: 600; letter-spacing: -0.03em; }
  .brand-copy small { color: var(--site-muted); font-family: monospace; font-size: 0.5rem; letter-spacing: 0.16em; }

  .site-nav {
    display: flex;
    flex: 1;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 2vw, 2rem);
  }

  .nav-link {
    position: relative;
    display: grid;
    height: 100%;
    align-items: center;
    color: var(--site-muted);
    font-size: 0.8rem;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--site-accent);
    content: '';
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .nav-link:hover,
  .nav-link.active { color: var(--site-ink); }
  .nav-link:hover::after,
  .nav-link.active::after { opacity: 1; transform: scaleX(1); }

  .header-status {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.45rem;
    color: var(--site-muted);
    font-size: 0.65rem;
    white-space: nowrap;
  }

  .status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--site-teal);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--site-teal) 13%, transparent);
  }

  .site-main { min-height: calc(100vh - 8.5rem); }
  .page-frame { padding-block: clamp(2.5rem, 1vw, 5rem); }

  .page-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--site-line);
  }

  .eyebrow {
    margin: 0;
    color: var(--site-muted);
    font-family: monospace;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
  }

  .page-title {
    margin: 0.65rem 0 0;
    font-family: 'Iowan Old Style', 'Palatino Linotype', 'Songti SC', serif;
    font-size: clamp(2.2rem, 1rem + 1.5vw, 4.6rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .page-lede {
    max-width: 38rem;
    margin: 1rem 0 0;
    color: var(--site-muted);
    font-family: 'Iowan Old Style', 'Palatino Linotype', 'Songti SC', serif;
    font-size: 0.85rem;
    line-height: 1.8;
  }

  .back-link,
  .quiet-link {
    color: var(--site-accent);
    font-size: 0.78rem;
    text-decoration: none;
  }

  .back-link:hover,
  .quiet-link:hover { text-decoration: underline; text-underline-offset: 0.25rem; }

  .content-list {
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--site-line);
    list-style: none;
  }

  .content-list li {
    display: grid;
    grid-template-columns: minmax(8rem, 0.28fr) minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--site-line);
  }

  .content-list time,
  .content-list .list-meta {
    color: var(--site-muted);
    font-size: 0.75rem;
  }

  .content-list a {
    font-family: 'Iowan Old Style', 'Palatino Linotype', 'Songti SC', serif;
    font-size: 1.15rem;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .content-list a:hover { color: var(--site-accent); }

  .journal-cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: min(100%, 72rem);
    margin-top: 2rem;
    margin-inline: auto;
  }

  .journal-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    min-height: 11.5rem;
    padding: 1.35rem 1.5rem;
    background: var(--site-surface);
    border: 1px solid var(--site-line);
    border-radius: 0.8rem;
    text-decoration: none;
    box-shadow: 0 0.45rem 1.4rem rgba(26, 48, 46, 0.035);
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .journal-card.has-cover {
    grid-template-columns: 15rem minmax(0, 1fr) auto;
  }

  .card-cover {
    flex: 0 0 auto;
    width: 15rem;
    height: 9rem;
    object-fit: cover;
    border-radius: 0.55rem;
    align-self: stretch;
  }

  .journal-card:hover {
    background: #fff;
    border-color: color-mix(in srgb, var(--site-accent) 30%, var(--site-line));
    box-shadow: 0 0.8rem 1.8rem rgba(26, 48, 46, 0.08);
    transform: translateY(-2px);
  }

  .card-body {
    flex: 1;
    min-width: 0;
  }

  .journal-card .card-title {
    margin: 0 0 0.5rem;
    font-family: 'Iowan Old Style', 'Palatino Linotype', 'Songti SC', serif;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--site-ink);
  }

  .journal-card .card-desc {
    margin: 0 0 0.75rem;
    color: var(--site-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .journal-card .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    color: var(--site-muted);
    font-size: 0.75rem;
  }

  .journal-card .card-tags {
    display: flex;
    gap: 0.4rem;
  }

  .journal-card .tag {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    background: color-mix(in srgb, var(--site-accent) 13%, var(--site-surface));
    border-radius: 0.25rem;
    font-size: 0.72rem;
    color: var(--site-accent);
  }

  .journal-card .card-source {
    flex-shrink: 0;
    color: var(--site-muted);
    font-size: 0.75rem;
    white-space: nowrap;
    align-self: center;
  }

  .archive-grid,
  .tag-grid,
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
    margin-top: 2rem;
    border: 1px solid var(--site-line);
    background: var(--site-line);
  }

  .archive-card,
  .tag-card,
  .project-card {
    display: grid;
    min-height: 9rem;
    align-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem;
    background: var(--site-surface);
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease;
  }

  .archive-card:hover,
  .tag-card:hover,
  .project-card:hover { background: color-mix(in srgb, var(--site-accent) 8%, var(--site-surface)); transform: translateY(-2px); }
  .card-index { color: var(--site-muted); font-family: monospace; font-size: 0.65rem; }
  .card-title { font-family: 'Iowan Old Style', 'Palatino Linotype', 'Songti SC', serif; font-size: 1.7rem; }
  .card-meta { color: var(--site-muted); font-size: 0.75rem; }

  .article-layout { display: grid; grid-template-columns: minmax(0, 50rem) minmax(11rem, 14rem); align-items: start; gap: clamp(2rem, 5vw, 4.5rem); width: min(100%, 68rem); margin-inline: auto; }
  .article-page { min-width: 0; }
  .article-page .page-heading { display: block; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; margin-top: 1.1rem; color: var(--site-muted); font-size: 0.78rem; }
  .article-toc { position: sticky; top: 6.5rem; max-height: calc(100vh - 8rem); overflow: auto; padding: 1rem 0.85rem 1.05rem; border-radius: 0.9rem; background: rgba(255, 255, 255, 0.82); box-shadow: 0 0.7rem 1.5rem rgba(24, 43, 48, 0.07); scrollbar-width: thin; }
  .article-toc-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; padding: 0 0.55rem 0.8rem; color: var(--site-ink); font-size: 0.78rem; font-weight: 600; }
  .article-toc-heading::before { width: 0.22rem; height: 0.9rem; margin-right: 0.25rem; border-radius: 999px; background: var(--site-accent); content: ''; }
  .article-toc-heading span { flex: 1; }
  .article-toc-heading small { color: var(--site-muted); font-size: 0.64rem; font-weight: 400; white-space: nowrap; }
  .article-toc ol { display: grid; gap: 0.15rem; margin: 0; padding: 0; list-style: none; }
  .article-toc li a { display: block; overflow: hidden; padding: 0.42rem 0.55rem; border-radius: 0.45rem; color: var(--site-muted); font-size: 0.72rem; line-height: 1.45; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; transition: background 180ms ease, color 180ms ease, transform 180ms ease; }
  .article-toc li a:hover { background: #f1f3f4; color: var(--site-ink); transform: translateX(2px); }
  .article-toc li a.is-active { background: #eef1f2; color: var(--site-ink); font-weight: 600; }
  .article-toc .toc-depth-3 a { padding-left: 1.25rem; font-size: 0.68rem; }
  .article-toc .toc-depth-4 a { padding-left: 1.95rem; font-size: 0.66rem; }
  .prose { margin-top: 2.5rem; font-size: 1rem; line-height: 1.9; }
  .prose h2 { margin: 2.5rem 0 0.8rem; font-family: 'Iowan Old Style', 'Palatino Linotype', 'Songti SC', serif; font-size: 1.65rem; font-weight: 500; line-height: 1.3; }
  .prose h3 { margin: 2rem 0 0.7rem; font-size: 1.15rem; }
  .prose p { margin: 1rem 0; }
  .prose ul, .prose ol { padding-left: 1.35rem; }
  .prose li { margin: 0.35rem 0; }
  .prose a { color: var(--site-teal); text-underline-offset: 0.2rem; }
  .prose img { display: block; width: auto; max-width: min(100%, 40rem); max-height: 32rem; margin: 1.5rem auto; border-radius: 0.55rem; object-fit: contain; }
  .prose :not(pre) > code { padding: 0.16rem 0.38rem; border: 1px solid #e2e7ea; border-radius: 0.35rem; background: #f1f4f6; color: var(--site-ink); font-size: 0.9em; }
  .prose pre { overflow-x: auto; margin: 1.6rem 0; padding: 1.1rem 1.25rem; border: 1px solid #e1e6e8; border-radius: 0.9rem; background: #f7f8fa; color: #24373d; box-shadow: 0 0.75rem 1.8rem rgba(24, 43, 48, 0.08); font-family: 'Cascadia Code', 'SFMono-Regular', Consolas, monospace; font-size: 0.86rem; line-height: 1.75; }
  .prose pre code { padding: 0; background: transparent; color: inherit; font: inherit; }
  .article-page .prose [data-celestia-code-container] {
    --code-surface: #f6f8fa;
    --code-line: rgba(27, 31, 36, 0.1);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: 1.8rem 0;
    border: 1px solid #d0d7de;
    border-radius: 0.9rem;
    background: var(--code-surface);
    box-shadow: 0 1rem 2.4rem rgba(27, 31, 36, 0.1);
  }
  .article-page .prose [data-celestia-code-container]::before {
    position: absolute;
    z-index: 2;
    top: 0.95rem;
    left: 1.15rem;
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 50%;
    background: #ff5f56;
    box-shadow: 1rem 0 #ffbd2e, 2rem 0 #27c93f;
    content: '';
    pointer-events: none;
  }
  .article-page .prose [data-celestia-code-container]::after {
    position: absolute;
    z-index: 1;
    top: 2.55rem;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--code-line);
    content: '';
    pointer-events: none;
  }
  .article-page .prose [data-celestia-code-container] pre.astro-code {
    position: relative;
    overflow-x: auto;
    margin: 0;
    padding: 3.35rem 0 1.15rem;
    border: 0;
    border-radius: 0;
    background: var(--code-surface) !important;
    box-shadow: none;
    color: var(--shiki-light);
    font-family: 'Cascadia Code', 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
    font-size: 0.84rem;
    line-height: 1.72;
    scrollbar-color: #8c959f var(--code-surface);
    tab-size: 2;
  }
  .article-page .prose [data-celestia-code-container] pre[data-language]::before {
    position: absolute;
    top: 0.72rem;
    right: 1rem;
    color: #57606a;
    content: attr(data-language);
    font-family: 'Avenir Next', 'PingFang SC', sans-serif;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }
  .article-page .prose [data-celestia-code-container] pre > code {
    display: grid;
    min-width: min-content;
    padding: 0;
    color: var(--shiki-light);
    font: inherit;
  }
  .article-page .prose [data-celestia-code-container] .line {
    display: inline-block;
    width: 100%;
    min-width: max-content;
    padding: 0 1.25rem;
    transition: background 120ms ease;
  }
  .article-page .prose [data-celestia-code-container] .line:hover { background: rgba(137, 184, 164, 0.07); }
  .article-page .prose .astro-code,
  .article-page .prose .astro-code span {
    color: var(--shiki-light);
    font-style: var(--shiki-light-font-style);
    font-weight: var(--shiki-light-font-weight);
    text-decoration: var(--shiki-light-text-decoration);
  }
  .article-page .prose [data-celestia-code-container] celestia-code-copy-button { display: none; }
  .prose blockquote { margin-inline: 0; padding-left: 1rem; border-left: 3px solid var(--site-accent); color: var(--site-muted); }
  .prose .migration-notice { margin: 0 0 1.5rem; padding: 0.9rem 1rem; border-radius: 0.75rem; background: color-mix(in srgb, var(--site-accent) 9%, var(--site-surface)); color: var(--site-muted); font-size: 0.9rem; }
  .empty-message { margin-top: 2rem; color: var(--site-muted); }

  .site-footer { border-top: 1px solid var(--site-line); }
  .footer-inner { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.4rem; color: var(--site-muted); font-size: 0.7rem; }

  a:focus-visible { outline: 2px solid var(--site-accent); outline-offset: 4px; }

  .remix-icon.arrow-icon { display: inline-block; width: 1em; height: 1em; flex: 0 0 auto; vertical-align: -0.12em; }

  @media (max-width: 48rem) {
    .header-inner { flex-wrap: wrap; gap: 0.8rem 1.2rem; padding-block: 0.8rem; }
    .site-nav { order: 3; flex-basis: 100%; justify-content: flex-start; overflow-x: auto; min-height: 2rem; gap: 1.2rem; }
    .header-status { margin-left: auto; }
    .page-heading { align-items: start; flex-direction: column; gap: 1.2rem; }
    .article-layout { display: block; width: 100%; }
    .article-toc { position: static; max-height: none; margin-top: 2.5rem; }
    .content-list li { grid-template-columns: 1fr auto; gap: 0.45rem 0.8rem; }
    .content-list time { grid-column: 1 / -1; }
    .journal-card,
    .journal-card.has-cover { grid-template-columns: 1fr; gap: 0.85rem; min-height: 0; padding: 1.1rem 1.2rem; }
    .journal-card .card-source { align-self: start; }
    .card-cover { width: 100%; height: 10rem; }
  }

  @media (max-width: 34rem) {
    .header-inner, .page-frame, .footer-inner { width: min(100% - 1.5rem, 82rem); }
    .header-status { display: none; }
    .footer-inner { flex-direction: column; }
    .article-page .prose [data-celestia-code-container] { margin-inline: -0.25rem; border-radius: 0.75rem; }
    .article-page .prose [data-celestia-code-container] pre.astro-code { font-size: 0.78rem; }
    .article-page .prose [data-celestia-code-container] .line { padding-inline: 1rem; }
  }
</style>
