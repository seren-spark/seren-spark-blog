<div
  class="reading-progress"
  data-reading-progress
  role="progressbar"
  aria-label="文章阅读进度"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <span class="reading-progress__bar" aria-hidden="true"></span>
</div>

<script>
  type ReadingProgressWindow = Window & {
    __serenSparkReadingProgressController?: AbortController;
  };

  const setupReadingProgress = () => {
    const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
    if (!progress) return;

    // The fixed Starlight header creates its own containing block. Moving the
    // progress element to <body> keeps it pinned to the viewport edge.
    if (progress.parentElement !== document.body) document.body.append(progress);

    const appWindow = window as ReadingProgressWindow;
    appWindow.__serenSparkReadingProgressController?.abort();
    const controller = new AbortController();
    appWindow.__serenSparkReadingProgressController = controller;

    let frame = 0;
    const updateProgress = () => {
      frame = 0;
      const scrollableHeight = Math.max(
        document.documentElement.scrollHeight - window.innerHeight,
        0,
      );
      const ratio = scrollableHeight === 0
        ? 0
        : Math.min(Math.max(window.scrollY / scrollableHeight, 0), 1);
      const percentage = Math.round(ratio * 100);

      progress.style.setProperty('--reading-progress', String(ratio));
      progress.setAttribute('aria-valuenow', String(percentage));
    };

    const scheduleUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateProgress);
    };

    window.addEventListener('scroll', scheduleUpdate, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener('resize', scheduleUpdate, { signal: controller.signal });
    window.addEventListener('load', scheduleUpdate, { signal: controller.signal });
    updateProgress();
  };

  setupReadingProgress();
  document.addEventListener('astro:page-load', setupReadingProgress);
</script>

<style>
  .reading-progress {
    --reading-progress: 0;
    position: fixed;
    z-index: calc(var(--sl-z-index-navbar) + 1);
    inset: 0 0 auto;
    height: 3px;
    overflow: hidden;
    background: rgb(31 131 239 / 10%);
    pointer-events: none;
  }

  .reading-progress__bar {
    display: block;
    width: 100%;
    height: 100%;
    background: #1f83ef;
    box-shadow: 0 0 0.65rem rgb(31 131 239 / 48%);
    transform: scaleX(var(--reading-progress));
    transform-origin: left center;
    transition: transform 80ms linear;
    will-change: transform;
  }

  :global([data-theme='dark']) .reading-progress {
    background: rgb(102 179 255 / 12%);
  }

  :global([data-theme='dark']) .reading-progress__bar {
    background: #66b3ff;
    box-shadow: 0 0 0.7rem rgb(102 179 255 / 42%);
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress__bar { transition: none; }
  }

  @media print {
    .reading-progress { display: none; }
  }
</style>
