---
import type { HomeData } from '../../lib/content-queries';
import type { TimelineEvent } from '../../lib/content-model';
import RemixIcon from '../knowledge/RemixIcon.astro';

interface Props {
  home: HomeData;
  timeline: TimelineEvent[];
  latestProject?: TimelineEvent;
  payload: { stats: HomeData['stats']; activity: HomeData['activity']; activeDays: number; activityCount: number };
}

const { home, timeline, latestProject, payload } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC' });
const eventHref = (event: TimelineEvent) => event.collection === 'docs' ? `/${event.id}/` : `/${event.collection === 'journal' ? 'journal' : 'projects'}/${event.id}/`;
const eventDate = (event: TimelineEvent) => dateFormatter.format(event.date).replace(/\//g, '.');

---

<main class="digital-space" data-experience id="top">
  <canvas id="space-canvas" aria-hidden="true"></canvas><div class="grain" aria-hidden="true"></div><div class="cursor-orb" aria-hidden="true"></div>
  <div class="space-ui" aria-label="个人主页控制区">
    <a class="signature" href="/" aria-label="Hou Boran / 返回主页"><span class="signature-symbol">HB</span><span class="signature-label">DIGITAL<br />SPACE</span></a>
    <div class="scene-counter" aria-live="polite"><span data-current-scene>01</span><i>/</i><span>07</span></div>
    <div class="scene-rail" aria-label="页面场景导航">{Array.from({ length: 7 }, (_, index) => <button class:list={['rail-dot', index === 0 && 'is-current']} type="button" data-go-to={index} aria-label={`前往第 ${String(index + 1).padStart(2, '0')} 屏`}><span></span></button>)}</div>
    <div class="availability"><span class="live-dot"></span> OPEN TO BUILD</div>
  </div>
  <div class="scroll-progress" aria-hidden="true"><span data-progress></span></div>

  <div class="scene-deck">
    <section class="scene scene-hero is-active" data-scene="0" aria-labelledby="hero-title">
      <div class="scene-index">SCENE 01 <span>IDENTITY / 2026</span></div><div class="hero-copy"><p class="micro-label reveal-line"><span>HELLO, I'M</span></p><h1 id="hero-title" class="hero-title"><span>Hou</span><span class="title-accent">Boran</span></h1><p class="hero-subtitle reveal-line"><span>Front-end Engineer <b>×</b> Creative Developer</span></p><p class="hero-note reveal-line"><span>AI × WEB × INTERACTIVE EXPERIENCE</span></p></div>
      <div class="hero-visual" aria-hidden="true"><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="orbit orbit-c"></div><span class="visual-core"></span><span class="visual-cross cross-x"></span><span class="visual-cross cross-y"></span><span class="visual-caption">FIELD / 001<br />A SPACE FOR<br />MAKING THINGS MOVE</span></div>
      <a class="scroll-cue" href="#about"><span class="scroll-line"></span><span>SCROLL TO EXPLORE</span><span class="scroll-arrow">↓</span></a><span class="edge-note edge-note-left">31° 13' 42&quot; N / 121° 28' 38&quot; E</span><span class="edge-note edge-note-right">INTERACTIVE PERSONAL ARCHIVE</span>
    </section>

    <section id="about" class="scene scene-about" data-scene="1" aria-labelledby="about-title"><div class="scene-index">SCENE 02 <span>ABOUT / SIGNAL</span></div><div class="about-layout"><div class="about-heading"><p class="micro-label">A SHORT TRANSMISSION</p><h2 id="about-title">I build<br /><em>digital spaces</em><br />with a pulse.</h2><p class="about-lede">把界面当成一种空间来设计。让代码、动效和内容共同形成一个能被探索的现场。</p></div><div class="about-profile"><div class="portrait-frame"><div class="portrait-scan"></div><div class="portrait-shape"></div><span>PORTRAIT<br />PLACEHOLDER</span></div><dl class="profile-list"><div><dt>01 / FIELD</dt><dd>Computer Science<br />Front-end Engineering</dd></div><div><dt>02 / TOOLKIT</dt><dd>React · Vue · Node<br />Canvas · WebGL · AI</dd></div><div><dt>03 / CURRENTLY</dt><dd>Turning ideas into<br />interactive experiences.</dd></div></dl></div></div><span class="section-watermark">ABOUT / 02</span></section>

    <section class="scene scene-github" data-scene="2" aria-labelledby="github-title"><div class="scene-index">SCENE 03 <span>GITHUB / ACTIVITY FIELD</span></div><div class="github-layout"><div class="github-heading"><p class="micro-label">A YEAR IN MOTION</p><h2 id="github-title">Code leaves<br /><em>a topography.</em></h2><p>不是绿色方格。是时间留下的起伏、密度和方向。</p><a class="text-cta" href="https://github.com/" target="_blank" rel="noreferrer">OPEN GITHUB <span><RemixIcon name="arrow-right-s-line" class="arrow-icon" /></span></a></div><div class="activity-field"><div class="field-topline"><span>CONTENT ACTIVITY / 2026</span><span>LIVE TRACE</span></div><div class="voxel-grid" aria-label={`今年有 ${payload.activeDays} 天产生内容活动，共 ${payload.activityCount} 次`}>{Array.from({ length: 96 }, (_, index) => { const source = home.activity[index % Math.max(home.activity.length, 1)]; const count = source?.count ?? 0; const level = count === 0 ? (index % 11 === 0 ? 1 : index % 17 === 0 ? 2 : 0) : Math.min(4, count); return <span class={`voxel level-${level}`} style={`--i:${index};--h:${Math.max(level, 1)}`}></span>; })}</div><div class="field-bottomline"><span>LESS</span><span class="field-key"><i></i><i></i><i></i><i></i><i></i></span><span>MORE</span></div></div><dl class="github-stats"><div><dt>REPOSITORIES</dt><dd>0{home.stats.projects}</dd></div><div><dt>CONTENT NODES</dt><dd>{String(home.stats.total).padStart(2, '0')}</dd></div><div><dt>YEARS CODING</dt><dd>03</dd></div></dl></div></section>

    <section class="scene scene-galaxy" data-scene="3" aria-labelledby="galaxy-title"><div class="scene-index">SCENE 04 <span>TECHNOLOGY / GALAXY</span></div><div class="galaxy-heading"><p class="micro-label">THE THINGS I THINK WITH</p><h2 id="galaxy-title">A small<br /><em>technology galaxy.</em></h2></div><div class="galaxy"><span class="galaxy-core">WEB<small>the medium</small></span><button class="tech-node node-react" data-tech="React|Frontend architecture" type="button">React</button><button class="tech-node node-vue" data-tech="Vue|Interfaces with rhythm" type="button">Vue</button><button class="tech-node node-three" data-tech="Three.js|Interactive graphics" type="button">Three.js</button><button class="tech-node node-node" data-tech="Node.js|Systems behind the scene" type="button">Node.js</button><button class="tech-node node-ai" data-tech="AI|RAG / Agent / Tool calling" type="button">AI</button><button class="tech-node node-gsap" data-tech="GSAP|Motion as a material" type="button">GSAP</button><button class="tech-node node-canvas" data-tech="Canvas|Pixels with intention" type="button">Canvas</button><span class="galaxy-ring ring-one"></span><span class="galaxy-ring ring-two"></span></div><div class="tech-tooltip" data-tech-tooltip aria-live="polite"><span>HOVER A NODE</span></div></section>

    <section class="scene scene-timeline" data-scene="4" aria-labelledby="timeline-title"><div class="scene-index">SCENE 05 <span>JOURNEY / SELECTED TRACE</span></div><div class="timeline-heading"><p class="micro-label">THINGS THAT BECAME REAL</p><h2 id="timeline-title">The work<br /><em>so far.</em></h2></div><div class="journey-line" aria-hidden="true"><span class="journey-marker"></span></div><ol class="journey-list">{timeline.map((event, index) => <li class={`journey-item item-${index}`}><span class="journey-year">{event.date.getUTCFullYear()}</span><span class="journey-type">{event.collection.toUpperCase()} / {eventDate(event)}</span><a href={eventHref(event)}><strong>{event.title}</strong><small>{event.collection === 'projects' ? 'A project in progress, built from a need to keep learning visible.' : 'A trace from the archive — one thought, kept in motion.'}</small></a></li>)}{latestProject && <li class="journey-item journey-now"><span class="journey-year">NOW</span><span class="journey-type">NEXT TRANSMISSION</span><a href={eventHref(latestProject)}><strong>Still becoming.</strong><small>The next scene is already being built.</small></a></li>}</ol><a class="text-cta timeline-cta" href="/projects/">VIEW PROJECT ARCHIVE <span><RemixIcon name="arrow-right-s-line" class="arrow-icon" /></span></a></section>

    <section class="scene scene-data" data-scene="5" aria-labelledby="data-title"><div class="scene-index">SCENE 06 <span>PERSONAL DATA / OBSERVATORY</span></div><div class="data-layout"><div class="data-heading"><p class="micro-label">A FEW NUMBERS, NO DASHBOARD</p><h2 id="data-title">Learning,<br /><em>visualized.</em></h2><p>数据只是痕迹。真正重要的是，它们让我继续往哪里走。</p></div><div class="observatory" aria-label="个人记录数据可视化"><div class="orbit-data orbit-data-a"><span>DOCS</span><strong>{home.stats.notes}</strong></div><div class="orbit-data orbit-data-b"><span>JOURNAL</span><strong>{home.stats.journal}</strong></div><div class="orbit-data orbit-data-c"><span>PROJECTS</span><strong>{home.stats.projects}</strong></div><div class="observatory-core"><span>HB</span><small>IN MOTION</small></div><div class="data-axis axis-x"></div><div class="data-axis axis-y"></div></div><div class="data-footer"><span>FIELD NOTE 06</span><span>KEEP MOVING / KEEP MAKING</span></div></div></section>

    <section class="scene scene-explore" data-scene="6" aria-labelledby="explore-title"><div class="scene-index">SCENE 07 <span>EXIT / EXPLORE</span></div><div class="explore-layout"><p class="micro-label">WHERE TO NEXT?</p><h2 id="explore-title">Choose<br /><em>a direction.</em></h2><nav class="explore-links" aria-label="个人主页入口"><a href="/knowledge/" data-explore>KNOWLEDGE <span><RemixIcon name="arrow-right-s-line" class="arrow-icon" /></span></a><a href="/journal/" data-explore>JOURNAL <span><RemixIcon name="arrow-right-s-line" class="arrow-icon" /></span></a><a href="/projects/" data-explore>PROJECTS <span><RemixIcon name="arrow-right-s-line" class="arrow-icon" /></span></a><a href="https://github.com/" target="_blank" rel="noreferrer" data-explore>GITHUB <span><RemixIcon name="arrow-right-s-line" class="arrow-icon" /></span></a></nav><p class="explore-footer">A DEVELOPER'S DIGITAL SPACE / HOU BORAN / 2026</p></div><a class="back-top" href="#top" data-go-to="0">BACK TO ORIGIN ↑</a></section>
  </div>

</main>

<style is:global>
  :root { color-scheme: dark; } html { scroll-behavior: auto; background: #050706; } body { margin: 0; min-width: 320px; background: #050706; color: #eaf0e8; font-family: "IBM Plex Mono", "SFMono-Regular", Consolas, monospace; } body:has(.digital-space) { overflow-x: hidden; } body:has(.digital-space) .site-header, body:has(.digital-space) .site-footer { display: none; } * { box-sizing: border-box; } a { color: inherit; } button { font: inherit; } ::selection { background: #b7ff52; color: #07100a; }
  .digital-space { --acid:#b7ff52; --cyan:#7ef6dc; --orange:#ff9966; --ink:#eaf0e8; --muted:#85908a; --hairline:rgba(216,234,224,.16); position:relative; isolation:isolate; min-height:100svh; overflow:hidden; background:#050706; } #space-canvas { position:fixed; z-index:-4; inset:0; width:100%; height:100%; opacity:.92; } .digital-space::before { position:fixed; z-index:-2; inset:0; pointer-events:none; background:linear-gradient(90deg,rgba(5,7,6,.8),transparent 30%,transparent 70%,rgba(5,7,6,.55)),radial-gradient(circle at 50% 50%,transparent 30%,rgba(5,7,6,.5) 100%); content:''; } .grain { position:fixed; z-index:8; inset:-50%; pointer-events:none; opacity:.085; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.72'/%3E%3C/svg%3E"); transform:rotate(4deg); } .cursor-orb { position:fixed; z-index:7; width:1.2rem; height:1.2rem; margin:-.6rem; border:1px solid rgba(183,255,82,.65); border-radius:50%; pointer-events:none; mix-blend-mode:screen; }
  .space-ui { position:fixed; z-index:10; inset:0; pointer-events:none; } .signature,.scene-counter,.availability,.scene-rail,.scroll-progress { pointer-events:auto; } .signature { position:absolute; top:clamp(1.3rem,3vw,2.5rem); left:clamp(1.2rem,4vw,4.5rem); display:flex; align-items:center; gap:.75rem; text-decoration:none; } .signature-symbol { display:grid; width:2.2rem; height:2.2rem; place-items:center; border:1px solid var(--acid); color:var(--acid); font-family:Arial Narrow,sans-serif; font-size:.76rem; letter-spacing:-.08em; transform:rotate(-8deg); } .signature-label { color:var(--muted); font-size:.52rem; line-height:1.35; letter-spacing:.12em; } .scene-counter { position:absolute; top:clamp(1.5rem,3vw,2.7rem); left:50%; display:flex; gap:.55rem; color:var(--acid); font-size:.65rem; letter-spacing:.1em; transform:translateX(-50%); } .scene-counter i { color:var(--muted); font-style:normal; } .availability { position:absolute; top:clamp(1.5rem,3vw,2.7rem); right:clamp(1.2rem,4vw,4.5rem); color:var(--muted); font-size:.55rem; letter-spacing:.12em; } .live-dot { display:inline-block; width:.42rem; height:.42rem; margin-right:.45rem; border-radius:50%; background:var(--acid); box-shadow:0 0 0 .25rem rgba(183,255,82,.09),0 0 .7rem var(--acid); animation:pulse 1.8s ease-in-out infinite; } .scene-rail { position:fixed; top:50%; right:clamp(1.2rem,3vw,3rem); display:grid; gap:.8rem; transform:translateY(-50%); } .rail-dot { position:relative; width:1.2rem; height:.8rem; padding:0; border:0; background:transparent; cursor:pointer; } .rail-dot span { position:absolute; top:.3rem; right:0; width:.32rem; height:.32rem; border:1px solid var(--muted); border-radius:50%; transition:.3s; } .rail-dot:hover span,.rail-dot.is-current span { width:.65rem; height:.65rem; top:.12rem; right:-.16rem; border-color:var(--acid); background:var(--acid); box-shadow:0 0 .8rem var(--acid); } .scroll-progress { position:fixed; z-index:11; bottom:0; left:0; width:100%; height:2px; background:rgba(255,255,255,.07); } .scroll-progress span { display:block; width:14.28%; height:100%; background:var(--acid); box-shadow:0 0 1rem var(--acid); transition:width .7s cubic-bezier(.22,1,.36,1); }
  .scene-deck { scroll-snap-type:y mandatory; } .scene { position:relative; display:grid; min-height:100svh; padding:clamp(6rem,12vh,8rem) clamp(1.2rem,8vw,9rem) clamp(3rem,8vh,5rem); scroll-snap-align:start; overflow:hidden; } .scene-index { position:absolute; top:clamp(6rem,13vh,8rem); left:clamp(1.2rem,4vw,4.5rem); color:var(--acid); font-size:.55rem; letter-spacing:.13em; } .scene-index span { margin-left:.8rem; color:var(--muted); } .micro-label { margin:0; color:var(--muted); font-size:.58rem; letter-spacing:.2em; } .text-cta { display:inline-flex; align-items:center; gap:.8rem; margin-top:2rem; color:var(--acid); font-size:.58rem; letter-spacing:.15em; text-decoration:none; } .text-cta span { font-size:1rem; transition:transform .3s; } .text-cta:hover span { transform:translate(4px,-4px); } h1,h2,p { margin:0; } h1,h2 { font-family:Arial Narrow,Bahnschrift Condensed,Impact,sans-serif; font-weight:400; letter-spacing:-.085em; text-transform:uppercase; } h2 em { color:var(--acid); font-style:normal; }
  .scene-hero { min-height:100svh; align-content:center; } .hero-copy { position:relative; z-index:2; margin-left:clamp(0rem,7vw,8rem); } .hero-title { display:grid; margin:1.2rem 0 1.6rem; max-width:10ch; font-size:clamp(5.4rem,14vw,15.5rem); line-height:.73; } .hero-title .title-accent { color:var(--acid); transform:translateX(.12em); } .hero-subtitle { color:var(--ink); font-family:Arial Narrow,sans-serif; font-size:clamp(1rem,1.5vw,1.45rem); } .hero-subtitle b { margin:0 .5rem; color:var(--acid); font-weight:400; } .hero-note { margin-top:1.2rem; color:var(--muted); font-size:.57rem; letter-spacing:.18em; } .hero-visual { position:absolute; top:50%; right:clamp(3rem,14vw,14rem); width:min(42vw,38rem); aspect-ratio:1; transform:translateY(-50%); opacity:.8; } .orbit { position:absolute; inset:12%; border:1px solid rgba(126,246,220,.33); border-radius:50%; transform:rotate(-30deg) skewX(12deg); animation:orbit-spin 28s linear infinite; } .orbit-a { inset:16%; border-color:rgba(183,255,82,.48); } .orbit-b { inset:3%; transform:rotate(57deg) skewX(-26deg); animation-duration:36s; animation-direction:reverse; } .orbit-c { inset:25%; border-style:dashed; opacity:.65; animation-duration:19s; } .visual-core { position:absolute; top:50%; left:50%; width:4.2rem; height:4.2rem; border:1px solid var(--acid); border-radius:50%; background:radial-gradient(circle,rgba(183,255,82,.4),rgba(183,255,82,.03) 60%,transparent 62%); box-shadow:0 0 3rem rgba(183,255,82,.25); transform:translate(-50%,-50%); } .visual-cross { position:absolute; top:50%; left:50%; background:rgba(126,246,220,.45); }.cross-x { width:100%;height:1px;transform:translate(-50%,-50%); }.cross-y { width:1px;height:100%;transform:translate(-50%,-50%); }.visual-caption { position:absolute; right:10%; bottom:18%; color:var(--muted); font-size:.48rem; line-height:1.55; letter-spacing:.12em; } .scroll-cue { position:absolute; bottom:clamp(2rem,6vh,4rem); left:clamp(1.2rem,4vw,4.5rem); display:flex; align-items:center; gap:.75rem; color:var(--muted); font-size:.54rem; letter-spacing:.13em; text-decoration:none; } .scroll-line { display:inline-block; width:3rem; height:1px; background:var(--acid); } .scroll-arrow { color:var(--acid); font-size:1rem; animation:bob 1.8s ease-in-out infinite; } .edge-note { position:absolute; bottom:clamp(2rem,6vh,4rem); color:rgba(234,240,232,.45); font-size:.46rem; letter-spacing:.09em; writing-mode:vertical-rl; }.edge-note-left { left:clamp(1.2rem,4vw,4.5rem); transform:translateY(-2.8rem) rotate(180deg); }.edge-note-right { right:clamp(1.2rem,4vw,4.5rem); }
  .scene-about,.scene-github,.scene-galaxy,.scene-timeline,.scene-data { align-content:center; } .about-layout { display:grid; grid-template-columns:minmax(0,1fr) minmax(20rem,.75fr); gap:clamp(3rem,10vw,11rem); align-items:center; width:min(100%,76rem); margin-inline:auto; } .about-heading h2,.github-heading h2,.galaxy-heading h2,.timeline-heading h2,.data-heading h2,.explore-layout h2 { margin-top:1.15rem; font-size:clamp(4rem,8.3vw,9.6rem); line-height:.82; } .about-lede,.github-heading>p:last-of-type,.data-heading>p:last-of-type { max-width:27rem; margin-top:2.2rem; color:var(--muted); font-family:Arial Narrow,sans-serif; font-size:1rem; line-height:1.7; } .about-profile { display:grid; gap:2rem; } .portrait-frame { position:relative; display:grid; width:min(100%,20rem); aspect-ratio:4/5; place-items:center; margin-left:auto; border:1px solid var(--hairline); background:linear-gradient(140deg,rgba(126,246,220,.1),transparent 50%),rgba(10,16,14,.35); overflow:hidden; }.portrait-frame::before,.portrait-frame::after { position:absolute; width:1.5rem;height:1.5rem;border-color:var(--acid);content:''; }.portrait-frame::before { top:-1px;left:-1px;border-top:1px solid;border-left:1px solid; }.portrait-frame::after { right:-1px;bottom:-1px;border-right:1px solid;border-bottom:1px solid; }.portrait-frame>span { z-index:1;color:rgba(234,240,232,.45);font-size:.5rem;line-height:1.5;text-align:center;letter-spacing:.15em; }.portrait-shape { position:absolute; width:42%;height:65%;border:1px solid rgba(183,255,82,.5);border-radius:48% 48% 42% 42%/36% 36% 58% 58%;background:radial-gradient(ellipse at 50% 40%,rgba(183,255,82,.15),transparent 60%); }.portrait-scan { position:absolute;z-index:2;width:100%;height:1px;background:var(--acid);opacity:.65;box-shadow:0 0 1rem var(--acid);animation:scan 4.2s linear infinite; }.profile-list { display:grid;gap:1rem;margin:0; }.profile-list div { display:grid;grid-template-columns:7rem 1fr;gap:1rem;padding-top:.8rem;border-top:1px solid var(--hairline); }.profile-list dt { color:var(--acid);font-size:.52rem; }.profile-list dd { margin:0;color:var(--muted);font-size:.62rem;line-height:1.6; }.section-watermark { position:absolute;right:-1rem;bottom:2rem;color:rgba(183,255,82,.08);font-family:Arial Narrow,sans-serif;font-size:13vw;letter-spacing:-.1em; }
  .github-layout { display:grid;grid-template-columns:minmax(14rem,.65fr) minmax(25rem,1.35fr);gap:2.5rem 6vw;align-items:end;width:min(100%,82rem);margin-inline:auto; }.github-heading>p:first-of-type { margin-bottom:1.3rem; }.github-heading>p:last-of-type { font-size:.83rem; }.activity-field { padding-top:.8rem; }.field-topline,.field-bottomline { display:flex;justify-content:space-between;color:var(--muted);font-size:.5rem;letter-spacing:.12em; }.voxel-grid { display:grid;grid-template-columns:repeat(12,1fr);gap:clamp(.25rem,.7vw,.55rem);align-items:end;margin:1.2rem 0;padding:1.5rem 0;perspective:800px;transform:rotateX(52deg) rotateZ(-4deg);transform-origin:bottom; }.voxel { display:block;aspect-ratio:1;border:1px solid rgba(126,246,220,.08);background:rgba(126,246,220,.06);box-shadow:0 0 .4rem rgba(126,246,220,0);transform:translateZ(calc(var(--h)*1.1rem));transition:.7s; }.voxel.level-1 { background:rgba(126,246,220,.24); }.voxel.level-2 { background:rgba(126,246,220,.4); }.voxel.level-3 { background:rgba(183,255,82,.66);border-color:rgba(183,255,82,.55); }.voxel.level-4 { background:var(--acid);border-color:var(--acid);box-shadow:0 0 1.5rem rgba(183,255,82,.45); }.field-key { display:flex;gap:.2rem; }.field-key i { width:.45rem;height:.45rem;background:rgba(126,246,220,.15); }.field-key i:nth-child(2){background:rgba(126,246,220,.35)}.field-key i:nth-child(3){background:rgba(126,246,220,.55)}.field-key i:nth-child(4){background:rgba(183,255,82,.7)}.field-key i:nth-child(5){background:var(--acid)}.github-stats { display:grid;grid-template-columns:repeat(3,1fr);grid-column:1/-1;gap:1rem;margin:1rem 0 0; }.github-stats div { padding-top:.8rem;border-top:1px solid var(--hairline); }.github-stats dt { color:var(--muted);font-size:.5rem;letter-spacing:.1em; }.github-stats dd { margin:.6rem 0 0;color:var(--acid);font-family:Arial Narrow,sans-serif;font-size:2.8rem;letter-spacing:-.06em; }
