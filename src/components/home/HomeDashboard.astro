---
import { getHomeData, getProjectEntries } from '../../lib/site-data';
import { buildYearHeatmap } from '../../lib/home-visualization';
import RemixIcon from '../knowledge/RemixIcon.astro';

const home = await getHomeData();
const projects = await getProjectEntries();
const currentYear = new Date().getUTCFullYear();
const currentYearCounts = home.timeline.reduce((counts, event) => {
  if (event.date.getUTCFullYear() === currentYear) counts[event.collection] += 1;
  return counts;
}, { docs: 0, journal: 0, projects: 0 });
const latestJournal = home.timeline.find((event) => event.collection === 'journal');
const formatMonthDay = (date?: Date) => date
  ? new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit', timeZone: 'UTC' }).format(date)
  : '暂无记录';
const summaryMetrics = [
  { label: '知识笔记', value: home.stats.notes, unit: '篇', detail: `今年新增 ${currentYearCounts.docs} 篇` },
  { label: '博客文章', value: home.stats.journal, unit: '篇', detail: `最近更新 ${formatMonthDay(latestJournal?.date)}` },
];
const compactNumber = new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 });
const regularNumber = new Intl.NumberFormat('zh-CN');
const insightMetrics = [
  { label: '累计字数', value: compactNumber.format(home.insights.wordCount) },
  { label: '记录跨度', value: `${regularNumber.format(home.insights.recordSpanDays)} 天` },
  { label: '当前关注', value: home.insights.focusTags.join(' / ') || '持续探索' },
];
const eventHref = (event: typeof home.timeline[number]) => event.collection === 'docs'
  ? `/${event.id}/`
  : `/${event.collection === 'journal' ? 'journal' : 'projects'}/${event.id}/`;
const collectionLabels = { docs: '知识', journal: '博客', projects: '项目' } as const;

const activityCategories = [
  { key: 'all', label: '全部内容', shortLabel: '全部', points: home.activity },
  { key: 'journal', label: '博客', shortLabel: '博客', points: home.activityByCollection.journal },
  { key: 'docs', label: '知识库', shortLabel: '知识库', points: home.activityByCollection.docs },
  { key: 'projects', label: '项目', shortLabel: '项目', points: home.activityByCollection.projects },
] as const;

const activityYears = [...new Set(home.activity.map((point) => Number(point.date.slice(0, 4))))]
  .filter(Number.isInteger)
  .sort((left, right) => right - left);
if (!activityYears.includes(currentYear)) activityYears.unshift(currentYear);

const activityViews = activityYears.map((year) => {
  const events = home.timeline.filter((event) => event.date.getUTCFullYear() === year).slice(0, 8);
  const timelineGroups = [...events.reduce((groups, event) => {
    const month = event.date.getUTCMonth() + 1;
    const key = `${month}月`;
    const entries = groups.get(key) ?? [];
    entries.push({
      title: event.title,
      href: eventHref(event),
      day: `${month}月${event.date.getUTCDate()}日`,
      type: collectionLabels[event.collection],
    });
    groups.set(key, entries);
    return groups;
  }, new Map<string, Array<{ title: string; href: string; day: string; type: string }>>()).entries()]
    .map(([month, entries]) => ({ month, entries }));
  const firstDayOffset = new Date(Date.UTC(year, 0, 1)).getUTCDay();
  const monthMarkers = Array.from({ length: 12 }, (_, month) => {
    const monthStart = new Date(Date.UTC(year, month, 1));
    const elapsedDays = Math.floor((monthStart.valueOf() - Date.UTC(year, 0, 1)) / 86_400_000);
    return { label: `${month + 1}月`, column: Math.floor((firstDayOffset + elapsedDays) / 7) + 1 };
  });

  return {
    year,
    categories: activityCategories.map((category) => {
      const points = category.points.filter((point) => point.date.startsWith(`${year}-`));
      return {
        key: category.key,
        label: category.label,
        cells: buildYearHeatmap(category.points, year),
        activeDays: points.length,
        activityCount: points.reduce((total, point) => total + point.count, 0),
      };
    }),
    monthMarkers,
    timelineGroups,
  };
});
const initialActivityView = activityViews[0];
const initialActivity = initialActivityView.categories[0];

const thoughts = [
  '慢一点没关系，方向比速度更重要。',
  '把复杂的事情做简单，把简单的事情做扎实。',
  '真正的成长，发生在无人喝彩的日常。',
  '允许答案迟到，但不要停止提问。',
  '你反复投入时间的地方，最终会成为你的形状。',
  '今天留下的一点痕迹，会替未来的你照亮来路。',
  '清醒地选择，安静地坚持。',
  '不是看见希望才前进，而是前进以后才看见希望。',
  '自由不是没有边界，而是知道自己为何出发。',
  '所有值得抵达的地方，都需要耐心。',
];

const statusLabels: Record<string, string> = {
  planned: '计划中',
  active: '持续构建',
  paused: '暂存',
  completed: '已完成',
};

const footerLinks = [
  { label: '首页', href: '/' },
  { label: '个人主页', href: '/about/' },
  { label: '知识库', href: '/getting-started/' },
  { label: '博客', href: '/journal/' },
];

const friendLinks = [
  { label: 'GitHub', href: 'https://github.com/' },
  { label: 'Astro', href: 'https://astro.build/' },
  { label: 'Starlight', href: 'https://starlight.astro.build/' },
  { label: 'MDN Web Docs', href: 'https://developer.mozilla.org/' },
  { label: 'Vite', href: 'https://vite.dev/' },
  { label: 'Node.js', href: 'https://nodejs.org/' },
];

const fallbackProjectTiles = [
  { title: '弹幕', description: '一个支持实时人像分割的弹幕，运用了虚拟轨道算法。' },
  { title: '数据大屏', description: '用图表整理实时数据与业务指标。' },
  { title: '文件上传', description: '大文件分片、Hash 与断点续传。' },
  { title: '权限后台', description: '菜单、按钮与路由权限控制。' },
  { title: '效率工具', description: '把重复开发流程沉淀成小工具。' },
];

const projectNoteImages = [
  '/media/便签/便签2.png',
  '/media/便签/猫.png',
  '/media/便签/便签3.png',
  '/media/便签/星星人.png',
];

const projectPreviewImages: Array<string | null> = [null, '/media/projects/vue-barrage.png', null, null];

const projectTiles = [
  ...projects.map((project, index) => ({
    title: project.data.title,
    description: project.data.description ?? '持续打磨中的项目。',
    href: '/projects/' + project.id + '/',
    status: statusLabels[project.data.status] ?? project.data.status,
    accent: index,
  })),
  ...fallbackProjectTiles.map((project, index) => ({
    ...project,
    href: '/projects/',
    status: '项目板块',
    accent: projects.length + index,
  })),
].slice(0, 4).map((project, index) => ({
  ...project,
  noteImage: projectNoteImages[index],
  previewImage: projectPreviewImages[index],
}));
---

<div class="home-dashboard" id="archive-console">
  <section class="home-screen detail-screen" data-home-screen id="dashboard" aria-labelledby="dashboard-title">
    <img class="dashboard-star-person" src="/media/star-person.png" width="394" height="407" alt="" aria-hidden="true" loading="lazy" decoding="async" />
    <!-- <div class="screen-heading">
      <div>
        <p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span>03 / 个人档案 · 实时切片</p>
        <h2 id="dashboard-title">让留下来的东西，<em>彼此看见。</em></h2>
      </div>
      <span class="screen-index" aria-hidden="true">03</span>
    </div> -->

    <div class="detail-layout">
      <section class="message-panel" aria-label="滚动的思想短句">
        <div class="thought-field" aria-label="滚动的思想短句">
          <div class="thought-stage" data-thought-stage aria-hidden="true">
            {Array.from({ length: 4 }).map(() => <div class="thought-lane"></div>)}
          </div>
          <div class="thought-fallback" aria-hidden="true">
            {thoughts.slice(0, 4).map((thought) => <span>{thought}</span>)}
          </div>
          <ul class="thought-seeds" data-thought-seeds aria-hidden="true">
            {thoughts.map((thought) => <li>{thought}</li>)}
          </ul>
          <ul class="sr-only">
            {thoughts.map((thought) => <li>{thought}</li>)}
          </ul>
        </div>
      </section>

      <aside class="stats-panel" aria-label="内容指标">
        <div class="stats-inner">
          <dl class="metric-strip">
            {summaryMetrics.map((metric) => (
              <div class="metric-item">
                <dt>{metric.label}</dt>
                <dd>
                  <strong>{metric.value}</strong>
                  <span>{metric.unit}</span>
                </dd>
                <small>{metric.detail}</small>
              </div>
            ))}
          </dl>
          <dl class="insight-strip">
            {insightMetrics.map((metric) => (
              <div>
                <dt>{metric.label}</dt>
                <dd>{metric.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </aside>
    </div>

    <div class="activity-data-grid" data-activity-panel>
      <section class="activity-panel" aria-labelledby="activity-title">
        <header class="activity-heading">
          <div>
            <p class="panel-kicker">年度活动 / ACTIVITY</p>
            <h3 id="activity-title"><span data-activity-heading-year>{initialActivityView.year}</span> 年<span data-activity-heading-category>{initialActivity.label}</span>活跃度</h3>
          </div>
          <p><strong data-activity-count>{initialActivity.activityCount}</strong> 次记录 · <strong data-active-days>{initialActivity.activeDays}</strong> 个活跃日</p>
        </header>

        <div class="activity-category-picker" aria-label="选择内容分类">
          {activityCategories.map((category, index) => (
            <button
              type="button"
              aria-pressed={index === 0 ? 'true' : 'false'}
              data-activity-category-button={category.key}
              data-category-label={category.label}
            >{category.shortLabel}</button>
          ))}
        </div>

        <div class="activity-layout">
          <div class="activity-views">
            {activityViews.flatMap((view, yearIndex) => view.categories.map((category, categoryIndex) => (
              <div
                class="activity-year-view"
                data-activity-view
                data-activity-year={view.year}
                data-activity-category={category.key}
                data-count={category.activityCount}
                data-active-days={category.activeDays}
                hidden={yearIndex !== 0 || categoryIndex !== 0}
              >
                  <div class="activity-scroll">
                    <div class="activity-calendar" role="img" aria-label={`${view.year} 年${category.label}共有 ${category.activityCount} 次内容记录，分布在 ${category.activeDays} 个活跃日`}>
                      <div class="activity-months" aria-hidden="true">
                        {view.monthMarkers.map((month) => <span style={`grid-column:${month.column}`}>{month.label}</span>)}
                      </div>
                      <div class="activity-body">
                        <div class="activity-weekdays" aria-hidden="true"><span>一</span><span>三</span><span>五</span></div>
                        <div class="activity-grid" aria-hidden="true">
                          {category.cells.map((day) => day ? (
                            <span class:list={['activity-cell', `level-${day.level}`]} title={`${day.date} · ${day.count} 次记录`}></span>
                          ) : <span class="activity-cell is-placeholder"></span>)}
                        </div>
                      </div>
                    </div>
                  </div>
              </div>
            )))}

            <footer class="activity-footer">
              <span>少</span>
              <span class="activity-key" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
              <span>多</span>
            </footer>
          </div>

          <div class="activity-year-picker" aria-label="选择活动年份">
            {activityViews.map((view, index) => (
              <button
                type="button"
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-activity-year-button={view.year}
              >{view.year}</button>
            ))}
          </div>
        </div>
      </section>

      <aside class="timeline-panel" aria-labelledby="timeline-title">
        <header class="timeline-heading">
          <div><p class="panel-kicker">内容轨迹 / TIMELINE</p><h3 id="timeline-title">文章时间线</h3></div>
          <a href="/archive/" aria-label="查看完整年度归档">全部 <RemixIcon name="arrow-right-s-line" class="arrow-icon" /></a>
        </header>

        {activityViews.map((view, index) => (
          <div class="timeline-year-view" data-timeline-year-view={view.year} hidden={index !== 0}>
            {view.timelineGroups.length > 0 ? view.timelineGroups.map((group) => (
              <section class="timeline-month">
                <h4>{group.month}<span>{view.year}</span></h4>
                <ol>
                  {group.entries.map((entry) => (
                    <li>
                      <i aria-hidden="true"></i>
                      <a href={entry.href}><strong>{entry.title}</strong><span>{entry.type} · {entry.day}</span></a>
                    </li>
                  ))}
                </ol>
              </section>
            )) : <p class="timeline-empty">这一年还没有内容记录。</p>}
          </div>
        ))}
      </aside>
    </div>
  </section>

  <section class="home-screen projects-screen" data-home-screen id="open-source" aria-labelledby="projects-title">
    <header class="projects-heading">
        <h2 id="projects-title">开源项目</h2>

      <a class="all-projects" href="/projects/">查看全部项目 <span aria-hidden="true"><RemixIcon name="arrow-right-s-line" class="arrow-icon" /></span></a>
    </header>

    <div class="home-project-grid">
      {projectTiles.map((project, index) => (
        <a class:list={['home-project-card', 'project-note-' + String(index + 1)]} href={project.href}>
          <img class="project-note-background" src={project.noteImage} alt="" aria-hidden="true" loading="lazy" decoding="async" />
          <div class="project-note-content">
            <div class="project-card-media">
              {project.previewImage ? (
                <img src={project.previewImage} alt={`${project.title} 项目预览`} loading="lazy" decoding="async" />
              ) : (
                <div class:list={['project-image-placeholder', 'project-image-placeholder-' + String(index + 1)]} aria-hidden="true">
                  <span>PROJECT {String(index + 1).padStart(2, '0')}</span>
                  <strong>{project.title}</strong>
                </div>
              )}
            </div>
            <div class="project-card-body">
              <h3>{project.title}<span aria-hidden="true"><RemixIcon name="arrow-right-s-line" class="arrow-icon" /></span></h3>
              <p>{project.description}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="home-screen home-footer-screen" data-home-screen id="home-footer" aria-labelledby="footer-quote">
    <div class="footer-quote-card">
      <p id="footer-quote">生活不止有代码，别忘了还有诗和远方。</p>
    </div>

    <footer class="home-footer">
      <div class="home-footer-main">
        <div class="footer-brand-block">
          <a class="footer-brand" href="/" aria-label="返回首页"><span>S</span>Seren Spark</a>
          <p>记录技术，也记录生活。<br />让值得留下的东西，在时间里慢慢生长。</p>
        </div>

        <nav class="footer-link-group" aria-label="页脚站内导航">
          <p>站内导航 <span>/ MENU</span></p>
          <div>
            {footerLinks.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true"><RemixIcon name="arrow-right-s-line" class="arrow-icon" /></span></a>)}
          </div>
        </nav>

        <nav class="footer-link-group friend-link-group" aria-label="常用友链">
          <p>常用友链 <span>/ LINKS</span></p>
          <div>
            {friendLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}<span aria-hidden="true"><RemixIcon name="arrow-right-s-line" class="arrow-icon" /></span></a>)}
          </div>
        </nav>
      </div>

      <div class="home-footer-bottom">
        <span>© 2026 SEREN SPARK</span>
        <span>BUILT WITH ASTRO · WRITTEN WITH CARE</span>
        <a href="#top">回到顶部 <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
  </section>
</div>

<style>
  :global(body:has(.home-dashboard)),
  :global(body:has(.home-dashboard) .site-main),
  :global(body:has(.home-dashboard) .site-footer) {
    background-color: var(--site-background);
    background-image: var(--site-background-pattern);
    background-size: 20px 20px;
  }
  :global(body:has(.home-dashboard) .site-main .page-frame) { width: 100%; max-width: none; padding: 0; }
  :global(body:has(.home-dashboard) .site-footer) { display: none; }

  .home-dashboard { display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;--ink: #263a32; --muted: #748078; --line: rgba(45, 70, 57, .15); --surface: #fbfaf6; --amber: #a96f3f; --blue: #f4f4f4; --accent: #4f6f8f; --coral: #a86c5b; width: min(calc(100% - 4rem), 76rem); margin: 0 auto; color: var(--ink); font-family: 'Avenir Next', 'PingFang SC', 'Microsoft YaHei', sans-serif; }
  .home-screen {display: flex;
    flex-direction: column;

    justify-content: center;    position: relative; min-height: 100svh; padding: clamp(2rem, 4.5vh, 3.25rem) 0; scroll-snap-align: start; }
  .screen-heading, .projects-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding-bottom: 1.35rem; border-bottom: 1px solid var(--line); }
  .eyebrow, .panel-kicker, .panel-code, .project-meta, .project-index, .all-projects, .activity-heading > p, .activity-footer { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .11em; text-transform: uppercase; }
  .eyebrow { display: flex; align-items: center; gap: .6rem; margin: 0; color: var(--muted); font-size: .66rem; }
  .signal-dot { display: inline-block; width: .42rem; height: .42rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 .22rem rgba(79,111,143,.14); }
  .signal-dot { animation: pulse 1.8s ease-in-out infinite; }
  .screen-heading h2, .projects-heading h2 { max-width: 38rem; margin: .75rem 0 0; color: var(--ink); font-family: 'Iowan Old Style', 'Palatino Linotype', 'Songti SC', serif; font-size: clamp(2.15rem, 3.4vw, 3.5rem); font-weight: 500; letter-spacing: -.065em; line-height: 1.02; }
  .screen-heading h2 em { color: var(--amber); font-style: normal; }
  .screen-intro { max-width: 40rem; margin: 1rem 0 0; color: var(--muted); font-family: 'Iowan Old Style', 'Palatino Linotype', 'Songti SC', serif; font-size: clamp(.95rem, .9rem + .2vw, 1.1rem); line-height: 1.75; }
  .screen-index { color: var(--ink); font-family: 'Iowan Old Style', 'Palatino Linotype', serif; font-size: clamp(4rem, 7vw, 6rem); font-weight: 400; letter-spacing: -.12em; line-height: .65; opacity: .08; }
  .detail-layout { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(21rem, .92fr); gap: clamp(1.5rem, 3vw, 2.75rem); align-items: center; margin-top: clamp(1.35rem, 2.5vh, 2rem); }
  .dashboard-star-person { position: absolute; z-index: 0; top: clamp(-1rem, 6.5vh, 1.5rem); right: clamp(.2rem, 1vw, .8rem); width: clamp(9rem, 13vw, 11rem); height: auto; pointer-events: none; filter: drop-shadow(0 .7rem 1rem rgba(45,70,57,.12)); }
  .detail-screen > :not(.dashboard-star-person) { position: relative; z-index: 1; }
  .message-panel, .stats-panel { min-width: 0; }
  .stats-panel { display: flex; align-items: center; }
  .stats-inner { width: 100%; padding-right: clamp(8.5rem, 13vw, 10.75rem); }
  .message-panel { position: relative; display: flex; height: clamp(11.5rem, 24svh, 13.5rem); min-height: 0; overflow: hidden; flex-direction: column; padding: .65rem; border: 1px solid rgba(45,70,57,.16); border-radius: 1rem; background-image: linear-gradient(90deg, rgba(19,31,25,.22), rgba(19,31,25,.36)), url('/media/liuyan.jpg'); background-position: center 48%; background-size: cover; box-shadow: 0 .85rem 2.4rem rgba(45,70,57,.09); }
  .section-header { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .panel-kicker { color: var(--muted); font-size: .55rem; }
  .section-header h3 { margin: .55rem 0 0; color: var(--ink); font-family: 'Iowan Old Style', 'Palatino Linotype', 'Songti SC', serif; font-size: clamp(1.4rem, 1.1rem + .8vw, 2rem); font-weight: 500; letter-spacing: -.06em; }
  .thought-field { position: relative; flex: 1; min-height: 0; overflow: hidden; }
  .thought-stage { position: absolute; z-index: 1; display: grid; grid-template-rows: repeat(4, minmax(0, 1fr)); gap: .45rem; inset: 0; min-width: 0; overflow: hidden; padding-block: .75rem; pointer-events: none; }
  .thought-lane { position: relative; min-width: 0; overflow: visible; }
  .thought-seeds { display: none; }
  .thought-fallback { display: none; }
  :global(.thought-danmaku-pill) { display: inline-flex; align-items: center; padding: .36rem .78rem; border: 1px solid rgba(255,255,255,.12); border-radius: 999px; background: rgba(12,16,18,.58); color: rgba(255,255,255,.96); font-family: 'Avenir Next', 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: clamp(.8rem, .74rem + .18vw, .94rem); line-height: 1.25; white-space: nowrap; box-shadow: 0 .2rem .65rem rgba(0,0,0,.08); backdrop-filter: blur(3px); }
  .all-projects span { transition: transform .2s ease; } .all-projects:hover span { display: inline-block; transform: translate(3px, -3px); }
  .panel-code { padding: .35rem .5rem; border: 1px solid var(--line); color: var(--amber); font-size: .5rem; }
  .metric-strip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2.3vw, 2.25rem); margin: 0; padding-inline: clamp(.25rem, 1vw, .8rem); align-items: start; }
  .metric-item { display: flex; min-width: 0; flex-direction: column; gap: .42rem; align-items: flex-start; text-align: left; }
  .metric-item dd { display: flex; order: -1; align-items: baseline; gap: .45rem; margin: 0; color: #29434e; font-family: 'Iowan Old Style', Baskerville, 'Palatino Linotype', 'Times New Roman', serif; font-variant-numeric: tabular-nums; line-height: 1; }
  .metric-item dd strong { font-size: clamp(2.85rem, 3.9vw, 4.2rem); font-weight: 400; letter-spacing: -.045em; }
  .metric-item dd span { color: #8a949d; font-family: 'Avenir Next', 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: clamp(.65rem, .58rem + .18vw, .76rem); font-weight: 500; letter-spacing: .04em; }
