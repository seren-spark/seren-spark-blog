<script>
  import Danmaku from 'danmaku';

  const setupThoughtStreams = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-thought-stage]').forEach((stage) => {
      if (stage.dataset.ready === 'true' || prefersReducedMotion) return;

      const panel = stage.closest<HTMLElement>('.message-panel');
      const seedList = panel?.querySelector<HTMLElement>('[data-thought-seeds]');
      if (!seedList) return;

      const seeds = Array.from(seedList.querySelectorAll<HTMLElement>('li'))
        .map((item) => item.textContent?.trim() ?? '')
        .filter((item) => Boolean(item));

      if (seeds.length === 0) return;
      stage.dataset.ready = 'true';

      const speed = 78;
      const lanes = Array.from(stage.querySelectorAll<HTMLElement>('.thought-lane'));
      const createStreams = () => lanes.map((lane) => new Danmaku({ container: lane, engine: 'dom', speed }));
      let streams = createStreams();
      let cursor = 0;
      let laneCursor = 0;
      let emitted = 0;
      let intervalId: number | undefined;

      const createPill = (seed: string) => {
        const pill = document.createElement('span');
        pill.className = 'thought-danmaku-pill';
        pill.textContent = seed;
        return pill;
      };

      const emitNext = () => {
        if (emitted > 0 && emitted % 72 === 0) {
          streams.forEach((stream) => stream.destroy());
          streams = createStreams();
        }

        const seed = seeds[cursor % seeds.length];
        const stream = streams[laneCursor % streams.length];
        cursor += 1;
        laneCursor += 1;
        emitted += 1;
        stream.emit({ mode: 'rtl', render: () => createPill(seed) });
      };

      const start = () => {
        if (intervalId !== undefined) return;
        streams.forEach((stream) => stream.show());
        emitNext();
        intervalId = window.setInterval(emitNext, 2400);
      };

      const stop = () => {
        if (intervalId !== undefined) window.clearInterval(intervalId);
        intervalId = undefined;
        streams.forEach((stream) => stream.hide());
      };

      const visibilityObserver = new IntersectionObserver(
        ([entry]) => entry?.isIntersecting ? start() : stop(),
        { threshold: 0.12 },
      );
      visibilityObserver.observe(panel ?? stage);

      const sizeObserver = new ResizeObserver(() => streams.forEach((stream) => stream.resize()));
      sizeObserver.observe(stage);

      window.addEventListener('pagehide', () => {
        stop();
        visibilityObserver.disconnect();
        sizeObserver.disconnect();
        streams.forEach((stream) => stream.destroy());
      }, { once: true });
    });
  };

  const setupActivityFilters = () => {
    document.querySelectorAll<HTMLElement>('[data-activity-panel]').forEach((panel) => {
      if (panel.dataset.yearPickerReady === 'true') return;

      const headingYear = panel.querySelector<HTMLElement>('[data-activity-heading-year]');
      const headingCategory = panel.querySelector<HTMLElement>('[data-activity-heading-category]');
      const activityCount = panel.querySelector<HTMLElement>('[data-activity-count]');
      const activeDays = panel.querySelector<HTMLElement>('[data-active-days]');
      const yearButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-activity-year-button]'));
      const categoryButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-activity-category-button]'));
      const activityViews = Array.from(panel.querySelectorAll<HTMLElement>('[data-activity-view]'));
      const timelineViews = Array.from(panel.querySelectorAll<HTMLElement>('[data-timeline-year-view]'));
      if (!headingYear || !headingCategory || !activityCount || !activeDays || yearButtons.length === 0 || categoryButtons.length === 0) return;

      panel.dataset.yearPickerReady = 'true';
      let selectedYear = yearButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.activityYearButton ?? '';
      let selectedCategory = categoryButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.activityCategoryButton ?? 'all';

      const renderSelection = () => {
        yearButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.activityYearButton === selectedYear)));
        categoryButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.activityCategoryButton === selectedCategory)));
        activityViews.forEach((view) => {
          view.hidden = view.dataset.activityYear !== selectedYear || view.dataset.activityCategory !== selectedCategory;
        });
        timelineViews.forEach((view) => { view.hidden = view.dataset.timelineYearView !== selectedYear; });

        const activeView = activityViews.find((view) => !view.hidden);
        const activeCategory = categoryButtons.find((button) => button.dataset.activityCategoryButton === selectedCategory);
        headingYear.textContent = selectedYear;
        headingCategory.textContent = activeCategory?.dataset.categoryLabel ?? '全部内容';
        activityCount.textContent = activeView?.dataset.count ?? '0';
        activeDays.textContent = activeView?.dataset.activeDays ?? '0';
      };

      yearButtons.forEach((button) => button.addEventListener('click', () => {
        selectedYear = button.dataset.activityYearButton ?? selectedYear;
        renderSelection();
      }));
      categoryButtons.forEach((button) => button.addEventListener('click', () => {
        selectedCategory = button.dataset.activityCategoryButton ?? selectedCategory;
        renderSelection();
      }));
    });
  };

  setupThoughtStreams();
  setupActivityFilters();
  document.addEventListener('astro:page-load', () => {
    setupThoughtStreams();
    setupActivityFilters();
  });
</script>
