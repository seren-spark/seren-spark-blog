---
import type { HomeData } from '../../lib/content-queries';

interface Props { home: HomeData }
const { home } = Astro.props;
const latest = home.recent[0];
const recentHref = latest?.collection === 'journal' ? `/journal/${latest.id}/` : latest?.collection === 'projects' ? `/projects/${latest.id}/` : latest ? `/${latest.id}/` : '/knowledge/';
---

<main class="breathstone-site">
  <section class="breathstone-hero" id="top">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="https://images.unsplash.com/photo-1515377905703-c4788e51af15?auto=format&fit=crop&w=2200&q=85" aria-hidden="true">
      <source src="https://videos.pexels.com/video-files/3129595/3129595-uhd_3840_2160_25fps.mp4" type="video/mp4" />
    </video>
    <div class="hero-fallback" aria-hidden="true"></div>
    <div class="hero-shade" aria-hidden="true"></div>
    <nav class="glass-nav" aria-label="主导航">
      <a class="wordmark" href="#top"><span class="wordmark-mark">s</span><span>seren-spark<span class="wordmark-dot">.</span></span></a>
      <div class="desktop-nav"><a href="#practice">练习</a><a href="#stories">故事</a><a href="#access">进入</a></div>
      <a class="nav-cta" href="/knowledge/">打开档案 <span>↗</span></a>
    </nav>
    <div class="hero-body">
      <div class="hero-copy">
        <p class="eyebrow">SEREN-SPARK 的博客 <span>·</span> 安静地创造</p>
        <h1>让第一屏<br /><em>只属于你</em><br />保持独特。</h1>
        <p class="hero-support">记录想法、实验和行动之间的过程，把有用的东西留下，也给它们一点呼吸的空间。</p>
        <div class="hero-actions"><a class="button button-light" href="/knowledge/">进入知识档案 <span>↗</span></a><a class="text-link light-link" href="#practice">看看里面有什么 <span>↓</span></a></div>
      </div>
      <div class="hero-aside"><span class="aside-line"></span><span>为长期思考<br />而设计</span></div>
    </div>
    <div class="hero-bottom"><span>向下探索</span><span>上海 / 2026</span></div>
  </section>

  <section class="breathstone-section practice-section" id="practice">
    <div class="section-intro reveal"><p class="eyebrow olive">日常练习</p><h2>给好工作<br />留出<em>空间。</em></h2><p class="section-lede">这是一个持续生长的小型学习系统。界面保持柔和，让想法可以更清晰。</p></div>
    <div class="feature-list">
      <a class="feature-row reveal" href="/knowledge/"><span class="feature-number">01</span><span class="feature-title">沉淀下来的笔记</span><span class="feature-description">把值得反复回看的内容，整理成知识库。</span><span class="feature-arrow">↗</span></a>
      <a class="feature-row reveal" href="/journal/"><span class="feature-number">02</span><span class="feature-title">博客</span><span class="feature-description">保留真实日期与真实语境的个人记录。</span><span class="feature-arrow">↗</span></a>
      <a class="feature-row reveal" href="/projects/"><span class="feature-number">03</span><span class="feature-title">正在进行的项目</span><span class="feature-description">记录想法、原型，以及从想法到交付之间有价值的过程。</span><span class="feature-arrow">↗</span></a>
    </div>
  </section>

  <section class="breathstone-section story-section" id="stories">
    <div class="story-image reveal"><div class="story-image-glow"></div><span class="story-image-label">现场记录 / 01</span></div>
    <div class="story-copy reveal"><p class="eyebrow olive">写给自己的话</p><blockquote>“好的界面，会为你真正想寻找的东西留出空间。”</blockquote><p class="story-detail">这个档案从细小的观察开始：发现一个规律，追问一个问题，完成一个比预期教会更多东西的项目。</p><a class="text-link dark-link" href={recentHref}>阅读最近记录 <span>↗</span></a></div>
  </section>

  <section class="breathstone-section access-section" id="access">
    <div class="access-heading reveal"><p class="eyebrow olive">进入方式</p><h2>从现在开始<br /><em>从你所在的地方。</em></h2></div>
    <div class="access-grid">
      <a class="access-card reveal" href="/journal/"><span class="access-label">01 / 轻轻开始</span><strong>静下来</strong><p>阅读一条来自真实生活与学习过程的记录。</p><span class="access-link">打开博客 ↗</span></a>
      <a class="access-card featured reveal" href="/knowledge/"><span class="access-label">02 / 继续深入</span><strong>练习</strong><p>沿着那些最终沉淀为知识的线索继续阅读。</p><span class="access-link">进入知识库 ↗</span></a>
      <a class="access-card reveal" href="/projects/"><span class="access-label">03 / 让它落地</span><strong>行动</strong><p>看看一个想法离开笔记本后会发生什么。</p><span class="access-link">查看项目档案 ↗</span></a>
    </div>
    <div class="access-stats reveal"><div><strong>{home.stats.notes}</strong><span>知识笔记</span></div><div><strong>{home.stats.journal}</strong><span>博客</span></div><div><strong>{home.stats.projects}</strong><span>进行中的项目</span></div><div><strong>{home.stats.total}</strong><span>内容节点</span></div></div>
  </section>

  <footer class="breathstone-footer"><div class="footer-top"><a class="wordmark dark-wordmark" href="#top"><span class="wordmark-mark">s</span><span>seren-spark<span class="wordmark-dot">.</span></span></a><p>一个用来思考、创造，<br />也让有用之物慢慢沉淀的个人空间。</p><a class="button button-dark" href="/knowledge/">进入知识档案 <span>↗</span></a></div><div class="footer-bottom"><span>seren-spark 的博客 / 2026</span><span>认真制作 <i>✦</i></span><a href="#top">回到顶部 ↑</a></div></footer>
</main>

<style is:global>
  :root { color-scheme: light; } html { scroll-behavior: smooth; background: #f1eee6; } body { margin: 0; min-width: 320px; color: #1d2822; background: #f1eee6; font-family: "Avenir Next", "PingFang SC", "Microsoft YaHei", sans-serif; } body:has(.breathstone-site) .site-header, body:has(.breathstone-site) .site-footer { display: none; } * { box-sizing: border-box; } a { color: inherit; } ::selection { color: #f5f2e9; background: #1f5e4a; }
  .breathstone-site { --paper:#f1eee6; --paper-deep:#e5e0d5; --ink:#1d2822; --muted:#718078; --olive:#436b56; --forest:#1f5e4a; --line:rgba(29,40,34,.16); --white:#f7f6f0; overflow:hidden; }
  .breathstone-hero { position:relative; display:flex; min-height:100svh; flex-direction:column; justify-content:space-between; overflow:hidden; color:#f6f5ed; background:#22392f; isolation:isolate; }.hero-video,.hero-fallback,.hero-shade { position:absolute; z-index:-3; inset:0; width:100%; height:100%; object-fit:cover; }.hero-video { filter:saturate(.68) contrast(.94); }.hero-fallback { z-index:-4; background:radial-gradient(ellipse at 65% 25%,rgba(167,205,160,.72),transparent 18%),radial-gradient(ellipse at 78% 77%,rgba(224,176,122,.58),transparent 24%),linear-gradient(125deg,#233c34 10%,#7f9b7b 53%,#d1aa82); animation:breath 12s ease-in-out infinite alternate; }.hero-shade { z-index:-2; background:linear-gradient(90deg,rgba(15,31,24,.72),rgba(15,31,24,.17) 65%,rgba(15,31,24,.22)),linear-gradient(0deg,rgba(10,25,18,.36),transparent 35%); }.glass-nav { position:relative; display:flex; z-index:2; width:calc(100% - clamp(2rem,8vw,10rem)); align-items:center; justify-content:space-between; gap:1.5rem; margin:clamp(1rem,2.6vw,2.2rem) auto 0; padding:.72rem .8rem .72rem 1rem; border:1px solid rgba(255,255,255,.28); border-radius:999px; background:rgba(31,54,44,.22); backdrop-filter:blur(20px); }.wordmark { display:inline-flex; align-items:center; gap:.6rem; font-family:Georgia,"Times New Roman",serif; font-size:1.05rem; letter-spacing:-.04em; text-decoration:none; }.wordmark-mark { display:grid; width:1.9rem; height:1.9rem; place-items:center; border:1px solid currentColor; border-radius:50%; font-size:1.2rem; font-style:italic; line-height:1; }.wordmark-dot { color:#b8d99c; }.desktop-nav { display:flex; gap:clamp(1.1rem,3vw,3rem); margin-left:auto; color:rgba(246,245,237,.75); font-size:.67rem; }.desktop-nav a { text-decoration:none; transition:color .25s; }.desktop-nav a:hover { color:#fff; }.nav-cta { display:inline-flex; align-items:center; gap:.65rem; padding:.66rem 1rem; border-radius:999px; color:#19362b; background:#dcecc2; font-size:.62rem; text-decoration:none; transition:transform .25s,background .25s; }.nav-cta:hover { background:#f4f2de; transform:translateY(-2px); }.nav-cta span { font-size:.9rem; }
  .hero-body { display:flex; width:calc(100% - clamp(2.5rem,13vw,16rem)); align-items:flex-end; justify-content:space-between; gap:2rem; margin:0 auto auto; padding-top:clamp(7rem,15vh,11rem); }.hero-copy { max-width:46rem; }.eyebrow { margin:0; color:rgba(246,245,237,.75); font-size:.59rem; letter-spacing:.14em; }.eyebrow span { margin:0 .4rem; color:#cae6ae; }.eyebrow.olive { color:var(--olive); }.hero-copy h1 { margin:1.35rem 0 1.6rem; color:var(--white); font-family:Georgia,"Times New Roman",serif; font-size:clamp(4.3rem,9.8vw,10.7rem); font-weight:400; letter-spacing:-.095em; line-height:.79; }.hero-copy h1 em { color:#d7efb6; font-style:italic; }.hero-support { max-width:30rem; margin:0; color:rgba(246,245,237,.83); font-size:clamp(.95rem,1.25vw,1.15rem); line-height:1.65; }.hero-actions { display:flex; align-items:center; gap:1.8rem; margin-top:2.4rem; }.button { display:inline-flex; align-items:center; gap:.95rem; padding:.92rem 1.15rem; border:1px solid transparent; border-radius:999px; font-size:.66rem; letter-spacing:.03em; text-decoration:none; transition:transform .25s,box-shadow .25s,background .25s; }.button span { font-size:1rem; }.button:hover { transform:translateY(-3px); box-shadow:0 10px 25px rgba(0,0,0,.12); }.button-light { color:#263b2e; background:#f0efdf; }.button-dark { color:#f4f2e9; background:#1e3027; }.text-link { display:inline-flex; align-items:center; gap:.7rem; font-size:.66rem; text-decoration:none; }.text-link span { font-size:1rem; transition:transform .25s; }.text-link:hover span { transform:translate(4px,-3px); }.light-link { color:rgba(246,245,237,.82); }.dark-link { color:var(--forest); }.hero-aside { display:flex; align-items:center; gap:.8rem; margin-bottom:1rem; color:rgba(246,245,237,.68); font-size:.52rem; line-height:1.5; letter-spacing:.1em; }.aside-line { width:3rem; height:1px; background:#cde7aa; }.hero-bottom { display:flex; width:calc(100% - clamp(2.5rem,13vw,16rem)); justify-content:space-between; margin:0 auto; padding:1rem 0 1.5rem; border-top:1px solid rgba(255,255,255,.26); color:rgba(246,245,237,.7); font-size:.52rem; letter-spacing:.14em; }
  .breathstone-section { width:min(100% - 2.5rem,86rem); margin-inline:auto; }.practice-section { padding-block:clamp(6rem,13vw,12rem); }.section-intro { display:grid; grid-template-columns:1fr 1.2fr; gap:3rem; align-items:end; }.section-intro h2,.access-heading h2 { margin:1rem 0 0; font-family:Georgia,"Times New Roman",serif; font-size:clamp(3.5rem,7.8vw,8rem); font-weight:400; letter-spacing:-.09em; line-height:.82; }.section-intro h2 em,.access-heading h2 em { color:var(--forest); font-style:italic; }.section-lede { max-width:27rem; margin:0 0 .4rem; color:var(--muted); font-size:1rem; line-height:1.75; }.feature-list { margin-top:clamp(4rem,9vw,8rem); border-top:1px solid var(--line); }.feature-row { display:grid; grid-template-columns:4rem minmax(13rem,1fr) minmax(12rem,.8fr) 2rem; gap:1rem; align-items:center; padding:1.5rem .2rem; border-bottom:1px solid var(--line); text-decoration:none; transition:padding .35s,background .35s; }.feature-row:hover { padding-inline:1.2rem; background:rgba(255,255,255,.4); }.feature-number,.feature-description { color:var(--muted); font-size:.62rem; }.feature-title { font-family:Georgia,"Times New Roman",serif; font-size:clamp(1.4rem,2.5vw,2.4rem); letter-spacing:-.05em; }.feature-description { line-height:1.5; }.feature-arrow { color:var(--forest); font-size:1.2rem; text-align:right; transition:transform .3s; }.feature-row:hover .feature-arrow { transform:translate(4px,-4px); }
  .story-section { display:grid; grid-template-columns:1.05fr .95fr; min-height:78vh; align-items:center; gap:clamp(3rem,10vw,12rem); padding-block:clamp(4rem,8vw,8rem); }.story-image { position:relative; min-height:clamp(22rem,40vw,39rem); overflow:hidden; background:linear-gradient(140deg,rgba(40,84,63,.42),transparent 40%),radial-gradient(circle at 70% 25%,#d8e8be,transparent 17%),linear-gradient(120deg,#b7c8ae,#6d8b77 46%,#d8aa79); }.story-image::before { position:absolute; inset:9%; border:1px solid rgba(255,255,255,.58); content:''; }.story-image::after { position:absolute; top:20%; left:28%; width:38%; height:54%; border:1px solid rgba(247,245,232,.8); border-radius:50% 45% 48% 52%; box-shadow:5rem 4rem 0 -3rem rgba(247,245,232,.22); content:''; transform:rotate(25deg); }.story-image-glow { position:absolute; top:13%; right:13%; width:5rem; height:5rem; border-radius:50%; background:#e6f3c8; box-shadow:0 0 5rem 2rem rgba(230,243,200,.5); }.story-image-label { position:absolute; right:1.4rem; bottom:1.4rem; color:rgba(255,255,255,.8); font-size:.52rem; letter-spacing:.12em; }.story-copy { max-width:30rem; }.story-copy blockquote { margin:1.3rem 0 2rem; color:var(--ink); font-family:Georgia,"Times New Roman",serif; font-size:clamp(2rem,3.8vw,4rem); letter-spacing:-.07em; line-height:.98; }.story-detail { max-width:22rem; margin:0; color:var(--muted); font-size:.95rem; line-height:1.75; }.story-copy .text-link { margin-top:2.2rem; }
  .access-section { padding-block:clamp(7rem,13vw,12rem) clamp(6rem,10vw,9rem); }.access-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; }.access-heading h2 { font-size:clamp(3.5rem,7.5vw,7.5rem); }.access-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-top:clamp(4rem,7vw,6rem); }.access-card { display:flex; min-height:20rem; flex-direction:column; padding:1.5rem; border:1px solid var(--line); text-decoration:none; transition:background .3s,transform .3s; }.access-card:hover,.access-card.featured { color:#f5f2e9; background:var(--forest); border-color:var(--forest); transform:translateY(-5px); }.access-label { color:var(--muted); font-size:.55rem; letter-spacing:.1em; }.access-card:hover .access-label,.access-card.featured .access-label { color:#bfdca7; }.access-card strong { margin-top:auto; font-family:Georgia,"Times New Roman",serif; font-size:clamp(2rem,3.2vw,3.2rem); font-weight:400; letter-spacing:-.07em; }.access-card p { max-width:16rem; margin:.8rem 0 2.3rem; color:var(--muted); font-size:.83rem; line-height:1.6; }.access-card:hover p,.access-card.featured p { color:rgba(245,242,233,.72); }.access-link { color:var(--forest); font-size:.62rem; }.access-card:hover .access-link,.access-card.featured .access-link { color:#d9efbc; }.access-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-top:clamp(4rem,8vw,7rem); padding-top:1rem; border-top:1px solid var(--line); }.access-stats div { display:grid; gap:.5rem; }.access-stats strong { color:var(--forest); font-family:Georgia,"Times New Roman",serif; font-size:3.1rem; font-weight:400; letter-spacing:-.08em; }.access-stats span { color:var(--muted); font-size:.57rem; text-transform:uppercase; letter-spacing:.1em; }
  .breathstone-footer { padding:clamp(4rem,7vw,6rem) clamp(1.25rem,7vw,8rem) 1.5rem; color:#e9eee2; background:#1e3027; }.footer-top { display:grid; grid-template-columns:1fr 1fr auto; gap:2rem; align-items:start; padding-bottom:clamp(5rem,12vw,10rem); }.dark-wordmark { color:#f5f3e9; }.footer-top p { margin:0; color:rgba(233,238,226,.68); font-family:Georgia,"Times New Roman",serif; font-size:1rem; line-height:1.5; }.footer-bottom { display:flex; justify-content:space-between; gap:1rem; padding-top:1rem; border-top:1px solid rgba(233,238,226,.2); color:rgba(233,238,226,.56); font-size:.56rem; letter-spacing:.05em; }.footer-bottom a { color:inherit; text-decoration:none; }.footer-bottom i { color:#cfe9a9; font-style:normal; }
  .reveal { opacity:0; transform:translateY(1.2rem); transition:opacity .8s ease,transform .9s cubic-bezier(.22,1,.36,1); }.reveal.is-visible { opacity:1; transform:none; }.feature-row:nth-child(2),.access-card:nth-child(2){transition-delay:.1s}.feature-row:nth-child(3),.access-card:nth-child(3){transition-delay:.2s} @keyframes breath { to { transform:scale(1.08); filter:hue-rotate(8deg); } }
  @media (max-width:700px){.desktop-nav,.hero-aside{display:none}.glass-nav{width:calc(100% - 1.5rem);margin-top:.75rem}.nav-cta{padding:.58rem .7rem;font-size:.55rem}.hero-body{width:calc(100% - 2.5rem);padding-top:7rem}.hero-copy h1{font-size:clamp(4rem,18vw,7rem)}.hero-support{max-width:20rem;font-size:.9rem}.hero-actions{align-items:flex-start;flex-direction:column;gap:1.1rem}.hero-bottom{width:calc(100% - 2.5rem);font-size:.46rem}.hero-bottom span:last-child{display:none}.breathstone-section{width:calc(100% - 2.5rem)}.section-intro,.story-section{grid-template-columns:1fr;gap:2rem}.section-intro h2,.access-heading h2{font-size:clamp(3.5rem,17vw,6rem)}.section-lede{max-width:20rem}.feature-row{grid-template-columns:2rem 1fr 1.2rem;gap:.55rem;padding-block:1.25rem}.feature-description{grid-column:2/-1;grid-row:2}.story-section{min-height:auto;padding-block:4rem}.story-image{min-height:24rem}.story-copy blockquote{font-size:2.5rem}.access-heading{align-items:flex-start;flex-direction:column}.access-grid{grid-template-columns:1fr;margin-top:3rem}.access-card{min-height:16rem}.access-stats{grid-template-columns:repeat(2,1fr);gap:2rem 1rem}.footer-top{grid-template-columns:1fr;gap:2rem;padding-bottom:5rem}.footer-top p{font-size:.9rem}.footer-bottom{flex-wrap:wrap}.footer-bottom span:nth-child(2){display:none}}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.hero-fallback,.reveal,.feature-row,.access-card{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
</style>

<script>
  const breathstone = document.querySelector('.breathstone-site');
  if (breathstone) {
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('is-visible')), { threshold: 0.18 });
    breathstone.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
  }
</script>
